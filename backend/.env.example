# Export these variables in your shell, or use uvicorn --env-file .env.
DATABASE_PATH=data/insightflow.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Optional: if set, all /api endpoints require X-API-Key.
INSIGHTFLOW_API_KEY=
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=10000
# Optional official Adaption integration; never sent to the frontend.
ADAPTION_API_KEY=
ADAPTION_TIMEOUT_SECONDS=30
