# VANTA Signal OS — Backend Configuration
# Copy this file to .env and adjust variables as needed:

# Persistence
# Defaults to data/vanta.sqlite3 (or existing data/insightflow.sqlite3 if present)
DATABASE_PATH=data/vanta.sqlite3

# Cross-Origin Resource Sharing (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security (Optional)
# If set, all /api/* routes require this value in the X-API-Key header
VANTA_API_KEY=

# Ingestion Limits
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=10000

# Adaption AI Integration (Optional)
# Required for live Adaption Adaptive Data runs; never exposed to the frontend client.
ADAPTION_API_KEY=
ADAPTION_TIMEOUT_SECONDS=30
